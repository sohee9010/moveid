# 이 파일을 복사해 .env 를 만들고 값을 채운다.  (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어 커밋되지 않는다.

# ── Docker (PostgreSQL / Keycloak) ─────────────────────────
POSTGRES_PASSWORD=change-me
# Keycloak 관리 콘솔(master realm) 관리자. MoveID 관리자 계정과는 다르다.
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# ── Google 로그인 (선택) ───────────────────────────────────
# Google Cloud Console > Google 인증 플랫폼 > 클라이언트 에서 발급.
# 비워 두면 Google 로그인만 동작하지 않고 나머지는 정상 동작한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
