{
  "name": "moveid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "kc:up": "docker compose up -d --wait",
    "kc:down": "docker compose down",
    "kc:reset": "docker compose down -v && docker compose up -d --wait",
    "kc:logs": "docker compose logs -f keycloak",
    "seed": "pnpm --filter @moveid/seed seed",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@moveid/config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "catalog:"
  }
}
